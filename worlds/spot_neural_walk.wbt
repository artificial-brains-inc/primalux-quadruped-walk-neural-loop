#VRML_SIM R2025a utf8
EXTERNPROTO "../protos/spot/Spot.proto"
EXTERNPROTO "../protos/FloorMarkings.proto"

WorldInfo {
  title "Prima-Lux - Spot recurrent walking"
  basicTimeStep 16
}
Viewpoint {
  # View from the front-left, aimed at (0, 0, 0.45), world +Z up.
  orientation 0.159838323967 0.066207201574 -0.984920462094 2.366880831382
  position 3.5 3.5 2.1
  follow "Spot"
  followType "Tracking Shot"
  followSmoothness 0
}
Background {
  skyColor [ 0.72 0.80 0.88 ]
}
DirectionalLight {
  direction -0.3 -0.5 -1
  intensity 1
  ambientIntensity 0.5
}
Solid {
  translation 0 0 -0.05
  children [
    Shape {
      appearance DEF FLOOR_MATERIAL PBRAppearance {
        baseColor 0.65 0.68 0.70
        roughness 1
        metalness 0
      }
      geometry DEF FLOOR_GEOMETRY Box { size 30 30 0.1 }
    }
  ]
  name "floor"
  boundingObject USE FLOOR_GEOMETRY
}
Solid {
  translation 0 15.025 0.05
  children [
    Shape {
      appearance USE FLOOR_MATERIAL
      geometry DEF WALL_X Box { size 30.1 0.05 0.1 }
    }
  ]
  name "north wall"
  boundingObject USE WALL_X
}
Solid {
  translation 0 -15.025 0.05
  children [
    Shape { appearance USE FLOOR_MATERIAL geometry USE WALL_X }
  ]
  name "south wall"
  boundingObject USE WALL_X
}
Solid {
  translation 15.025 0 0.05
  children [
    Shape {
      appearance USE FLOOR_MATERIAL
      geometry DEF WALL_Y Box { size 0.05 30 0.1 }
    }
  ]
  name "east wall"
  boundingObject USE WALL_Y
}
Solid {
  translation -15.025 0 0.05
  children [
    Shape { appearance USE FLOOR_MATERIAL geometry USE WALL_Y }
  ]
  name "west wall"
  boundingObject USE WALL_Y
}
FloorMarkings {}
Spot {
  translation 0 0 0.624
  name "Spot"
  controller "spot_neural_walk"
  window ""
  supervisor TRUE
  synchronization TRUE
}
